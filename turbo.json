{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "storybook-static/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "storybook:test": {},
    "build-storybook": {
      "outputs": [
        "storybook-static/**"
      ]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "check:types": {
      "dependsOn": [
        "^check:types"
      ]
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
